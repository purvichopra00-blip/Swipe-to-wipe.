{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "USE_NEW_ARCHITECTURE": "1"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "googleServicesFile": "./google-services.json"
      },
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "USE_NEW_ARCHITECTURE": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761011430"
      }
    }
  }
}